{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "powershell": "powershell -NoProfile -ExecutionPolicy Bypass -File .github/hooks/scripts/Log.ps1 SessionStart"
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "powershell": "powershell -NoProfile -ExecutionPolicy Bypass -File .github/hooks/scripts/Guard.ps1"
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "powershell": "powershell -NoProfile -ExecutionPolicy Bypass -File .github/hooks/scripts/Log.ps1 PostToolUse"
      }
    ]
  }
}